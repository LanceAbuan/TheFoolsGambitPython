{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfig": {
      "phases": {
        "setup": {
          "nixpkgsArchive": "",
          "pkgs": ["python3", "nodejs"]
        }
      }
    },
    "buildCommand": "cd client && npm install && npm run build"
  },
  "deploy": {
    "startCommand": "gunicorn train_server:app --bind 0.0.0.0:8080 --timeout 120",
    "healthcheckPath": "/api/train/status",
    "healthcheckTimeout": 120
  }
}
