# Hugging Face credentials
HF_TOKEN=hf_your_token_here
HF_REPO=your_username/chess-model

# Local model checkpoint directory
MODEL_DIR=~/.chess-models

# Training server URL (for Vercel to reach local server)
TRAINING_URL=http://localhost:8000

# Stockfish binary path
STOCKFISH_PATH=~/.local/bin/stockfish
